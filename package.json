{
  "name": "dsh-plugin-review-spec",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "description": "Host-side /review and /spec slash commands for DeepSeek Harness, delegating to tool-restricted subagents with call-time prompt files",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "review",
    "spec",
    "slash-commands",
    "subagent"
  ],
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "README.md",
    "LICENSE",
    "review.md",
    "spec.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
